# Local development template only. Never copy production or staging secrets into source control.
ENVIRONMENT=development
SECRET_KEY=replace-with-a-random-local-secret
DATABASE_URL=sqlite:///dmwas.db
SESSION_COOKIE_SECURE=false
PUBLIC_CONTACT_EMAIL=
PUBLIC_CONTACT_PHONE=
PUBLIC_CONTACT_ADDRESS=
MEMBER_ACTIVITY_PUBLICATION_ENABLED=false

# Local defaults for Phase 07. Deployed registration requires explicit approved policy values.
ACTIVITY_REGISTRATION_ENABLED=true
ACTIVITY_OFFER_HOURS=24
ACTIVITY_SIGNUP_CLOSE_MINUTES=60
ACTIVITY_CANCELLATION_CLOSE_MINUTES=60
ACTIVITY_RENEWAL_GRACE_HOURS=24
ACTIVITY_ALLOW_YOUTH_REGISTRATION=false

# Optional local email configuration; leave unset to suppress outbound email.
# RESEND_API_KEY=
# RESEND_FROM=
# ADMIN_NOTIFICATION_EMAIL=members@example.test
